# Explicit demo uses synthetic fixtures and never calls cloud providers.
APP_MODE=demo
COMPOSE_PROJECT_NAME=offerpilot
WEB_PORT=8080
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://offerpilot:offerpilot@localhost:55432/offerpilot
DB_PASSWORD=offerpilot
ALLOW_REGISTRATION=false
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
LLM_MODEL=deepseek-flash
RUN_MAX_CALLS=50
RUN_INPUT_TOKENS=80000
RUN_OUTPUT_TOKENS=24000
RUN_TIMEOUT_SECONDS=600
GLOBAL_RUN_CONCURRENCY=2
USER_RUN_CONCURRENCY=1
EXPORT_RETENTION_HOURS=24
